<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_rounded_surface"
    android:layout_marginBottom="8dp"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_drag_handle"
        android:contentDescription="Seret untuk ubah urutan" />

    <TextView
        android:id="@+id/tvPointOrder"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/marker_point_background"
        android:gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="13sp"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPointType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="Klik Sekali" />

        <TextView
            android:id="@+id/tvPointDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#99EDEFF7"
            android:textSize="11sp"
            tools:text="x=120, y=400 • jeda 500 md" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEditPoint"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@null"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/btn_save" />

    <ImageButton
        android:id="@+id/btnDeletePoint"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@null"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/btn_delete" />

</LinearLayout>
